# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
# This app runs on Solana DEVNET ONLY. The app refuses to start on any other RPC.

# --- Public (bundled into the browser) ---
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PASSPORT_PROGRAM_ID=
NEXT_PUBLIC_VAULT_PROGRAM_ID=
NEXT_PUBLIC_TUSDC_MINT=

# --- Server only (API routes). Devnet demo keypairs: base58 secret key or JSON byte array ---
DEMO_UNIVERSITY_KEYPAIR=
DEMO_LAB_KEYPAIR=
DEMO_PHARMA_KEYPAIR=
DEMO_KYC_KEYPAIR=
